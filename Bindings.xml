<Bindings>
  <Binding name="DIMENSION_TOGGLE" header="DIMENSION" category="ADDONS">
    Dimension:Toggle()
  </Binding>
  <Binding name="DIMENSION_MARK" category="ADDONS">
    Dimension.Overlay:MarkHovered()
  </Binding>
  <Binding name="DIMENSION_PIN" category="ADDONS">
    Dimension.Overlay:PinHovered()
  </Binding>
  <Binding name="DIMENSION_TIDY" category="ADDONS">
    Dimension.Tidy:Run()
  </Binding>
</Bindings>
